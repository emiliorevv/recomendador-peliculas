# Copia este archivo como `.streamlit/secrets.toml` para correr la app en local
# con `st.secrets`, o pega estas cuatro líneas en el panel "Secrets" de
# Streamlit Community Cloud. El formato es TOML, no `.env`.
#
# `.streamlit/secrets.toml` está en `.gitignore`: nunca se sube al repo.

NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME = ""
NEO4J_PASSWORD = ""
NEO4J_DATABASE = ""
